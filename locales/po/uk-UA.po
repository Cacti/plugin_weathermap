msgid "The image directory is not writable."
msgstr "Каталог зображень недоступний для запису."

#: lib/editor.assets.php
msgid "Choose a PNG, JPG or GIF image up to 4 million pixels."
msgstr "Виберіть зображення PNG, JPG або GIF розміром до 4 мільйонів пікселів."

#: lib/editor.assets.php
msgid "The image could not be read."
msgstr "Не вдалося прочитати зображення."

#: lib/editor.assets.php
msgid "Could not reserve an image filename."
msgstr "Не вдалося зарезервувати назву файлу зображення."

#: lib/editor.assets.php
msgid "Could not save the image."
msgstr "Не вдалося зберегти зображення."

#: lib/editor.colours.php
msgid "Choose a valid colour."
msgstr "Виберіть припустимий колір."

#: lib/editor.colours.php
msgid "Invalid pulse setting."
msgstr "Неприпустиме налаштування пульсації."

#: lib/editor.colours.php
msgid "The background needs a solid colour."
msgstr "Для фону потрібен суцільний колір."

#: lib/editor.colours.php
msgid "Keep between 1 and 200 scale rows."
msgstr "Залиште від 1 до 200 рядків шкали."

#: lib/editor.colours.php
#, php-format
msgid "Scale %s is defined in an included configuration and is read-only here. Edit its source file instead."
msgstr "Шкала %s визначена у включеній конфігурації та доступна тут лише для читання. Натомість відредагуйте її вихідний файл."

#: lib/editor.colours.php
msgid "Invalid scale name."
msgstr "Неприпустима назва шкали."

#: lib/editor.colours.php
msgid "Invalid scale range."
msgstr "Неприпустимий діапазон шкали."

#: lib/editor.colours.php
msgid "Range start must be no greater than its end."
msgstr "Початок діапазону не може бути більшим за його кінець."

#: lib/editor.colours.php
msgid "Invalid scale label."
msgstr "Неприпустима мітка шкали."

#: lib/editor.colours.php
msgid "A solid colour label cannot begin with three integers. Add a word first or choose a gradient end colour."
msgstr "Мітка суцільного кольору не може починатися з трьох цілих чисел. Додайте спочатку слово або виберіть кінцевий колір градієнта."

#: lib/editor.colours.php
msgid "Scale bounds need values that can be saved without rounding. Use up to six decimal places and exact bandwidth units."
msgstr "Межі шкали мають бути значеннями, які можна зберегти без округлення. Використовуйте до шести знаків після коми та точні одиниці пропускної здатності."

#: lib/editor.colours.php
msgid "Duplicate range in a scale."
msgstr "Повторюваний діапазон у шкалі."

#: lib/editor.colours.php
msgid "Gradients need two colours."
msgstr "Для градієнтів потрібні два кольори."

#: lib/editor.colours.php
msgid "Keep at least one DEFAULT traffic range."
msgstr "Залиште принаймні один діапазон трафіку DEFAULT."

#: lib/editor.colours.php
#, php-format
msgid "A map object still uses scale %s."
msgstr "Об'єкт карти все ще використовує шкалу %s."

