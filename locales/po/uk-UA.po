msgid "Centre"
msgstr "По центру"

#: lib/editor.comment-style.php
msgid "Edge"
msgstr "Збоку"

#: lib/editor.comment-style.php
msgid "Edge places comments beside the link; Centre places them over the arrow."
msgstr "«Збоку» розміщує коментарі поруч зі з'єднанням; «По центру» — поверх стрілки."

#: lib/editor.comment-style.php
msgid "Follow link curve"
msgstr "Слідувати вигину з'єднання"

#: lib/editor.comment-style.php
msgid "Link Comments"
msgstr "Коментарі з'єднань"

#: lib/editor.comment-style.php
msgid "Uses a TrueType font. Tight bends or text longer than the link use straight text."
msgstr "Використовує шрифт TrueType. На різких вигинах або якщо текст довший за з'єднання, використовується прямий текст."

#: lib/editor.comment-style.php
msgid "Positions along the link: 0% is the first node and 100% is the second. These move the traffic labels, not the comments."
msgstr "Позиції вздовж з'єднання: 0% — перший вузол, 100% — другий. Це переміщує мітки трафіку, а не коментарі."

#: lib/editor.comment-style.php
msgid "Traffic Label Positions"
msgstr "Позиції міток трафіку"

#: lib/editor.comment-style.php
msgid "IN"
msgstr "ВХІД"

#: lib/editor.comment-style.php
msgid "OUT"
msgstr "ВИХІД"

#: lib/editor.comment-style.php
msgid "Comment Style"
msgstr "Стиль коментарів"

#: lib/editor.comment-style.php
msgid "Use map default"
msgstr "За замовчуванням карти"

#: lib/editor.comment-style.php
msgid "Custom positions"
