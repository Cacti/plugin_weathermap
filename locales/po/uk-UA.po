msgid "Could not save the map configuration."
msgstr "Не вдалося зберегти конфігурацію карти."

#: lib/editor.assets.php
msgid "Invalid image category."
msgstr "Неприпустима категорія зображень."

#: lib/editor.assets.php
msgid "Symbolic links cannot be managed here."
msgstr "Символічними посиланнями не можна керувати тут."

#: lib/editor.assets.php
msgid "Invalid image filename."
msgstr "Неприпустима назва файлу зображення."

#: lib/editor.assets.php
msgid "Cannot check configuration references."
msgstr "Не вдається перевірити посилання в конфігураціях."

