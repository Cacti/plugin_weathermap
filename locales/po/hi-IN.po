#: lib/editor.inc.php:283
msgid "Note: filenames must contain no spaces and end in .conf"
msgstr "नोट: फ़ाइल नामों में कोई रिक्ति नहीं होनी चाहिए और .conf में समाप्त होना चाहिए"

#: lib/editor.inc.php:853
msgid "Ok"
msgstr "ठीक"

#: lib/editor.inc.php:854
msgid "Operation successful"
msgstr "ऑपरेशन सफल"

#: lib/editor.inc.php:855
msgid "The Operation was successful.  Details are below."
msgstr "ऑपरेशन सफल रहा।  विवरण नीचे हैं।"

