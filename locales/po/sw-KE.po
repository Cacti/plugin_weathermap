#: lib/editor.colours.php
msgid "Choose a valid colour."
msgstr "Chagua rangi halali."

#: lib/editor.colours.php
msgid "Invalid pulse setting."
msgstr "Mpangilio batili wa mapigo."

#: lib/editor.colours.php
msgid "The background needs a solid colour."
msgstr "Mandharinyuma inahitaji rangi thabiti."

#: lib/editor.colours.php
msgid "Keep between 1 and 200 scale rows."
msgstr "Weka kati ya safu mlalo 1 na 200 za skeli."

#: lib/editor.colours.php
#, php-format
msgid "Scale %s is defined in an included configuration and is read-only here. Edit its source file instead."
msgstr "Skeli %s imefafanuliwa katika usanidi uliojumuishwa na ni ya kusoma pekee hapa. Hariri faili yake chanzo badala yake."

#: lib/editor.colours.php
msgid "Invalid scale name."
msgstr "Jina batili la skeli."

#: lib/editor.colours.php
msgid "Invalid scale range."
msgstr "Masafa batili ya skeli."

#: lib/editor.colours.php
msgid "Range start must be no greater than its end."
msgstr "Mwanzo wa masafa lazima usiwe mkubwa kuliko mwisho wake."

#: lib/editor.colours.php
msgid "Invalid scale label."
msgstr "Lebo batili ya skeli."

#: lib/editor.colours.php
msgid "A solid colour label cannot begin with three integers. Add a word first or choose a gradient end colour."
msgstr "Lebo ya rangi thabiti haiwezi kuanza na nambari kamili tatu. Ongeza neno kwanza au chagua rangi ya mwisho ya mgeuko wa rangi."

#: lib/editor.colours.php
msgid "Scale bounds need values that can be saved without rounding. Use up to six decimal places and exact bandwidth units."
msgstr "Mipaka ya skeli inahitaji thamani zinazoweza kuhifadhiwa bila kukadiria. Tumia hadi nafasi sita za desimali na vipimo halisi vya upana wa bendi."

#: lib/editor.colours.php
msgid "Duplicate range in a scale."
msgstr "Masafa yaliyorudiwa katika skeli."

#: lib/editor.colours.php
msgid "Gradients need two colours."
msgstr "Migeuko ya rangi inahitaji rangi mbili."

#: lib/editor.colours.php
msgid "Keep at least one DEFAULT traffic range."
msgstr "Weka angalau masafa moja ya trafiki ya DEFAULT."

#: lib/editor.colours.php
#, php-format
msgid "A map object still uses scale %s."
msgstr "Kitu cha ramani bado kinatumia skeli %s."

