msgid "Invalid pulse setting."
msgstr "პულსაციის არასწორი პარამეტრი."

#: lib/editor.colours.php
msgid "The background needs a solid colour."
msgstr "ფონს სჭირდება ერთგვაროვანი ფერი."

#: lib/editor.colours.php
msgid "Keep between 1 and 200 scale rows."
msgstr "დატოვეთ 1-დან 200-მდე სკალის მწკრივი."

#: lib/editor.colours.php
#, php-format
msgid "Scale %s is defined in an included configuration and is read-only here. Edit its source file instead."
msgstr "სკალა %s განსაზღვრულია ჩართულ კონფიგურაციაში და აქ მხოლოდ წასაკითხია. ნაცვლად ამისა ჩაასწორეთ მისი საწყისი ფაილი."

#: lib/editor.colours.php
msgid "Invalid scale name."
msgstr "სკალის არასწორი სახელი."

#: lib/editor.colours.php
msgid "Invalid scale range."
msgstr "სკალის არასწორი დიაპაზონი."

#: lib/editor.colours.php
msgid "Range start must be no greater than its end."
msgstr "დიაპაზონის დასაწყისი არ უნდა აღემატებოდეს მის დასასრულს."

#: lib/editor.colours.php
msgid "Invalid scale label."
msgstr "სკალის არასწორი წარწერა."

#: lib/editor.colours.php
msgid "A solid colour label cannot begin with three integers. Add a word first or choose a gradient end colour."
msgstr "ერთგვაროვანი ფერის წარწერა არ შეიძლება იწყებოდეს სამი მთელი რიცხვით. ჯერ დაამატეთ სიტყვა ან აირჩიეთ გრადიენტის საბოლოო ფერი."

#: lib/editor.colours.php
msgid "Scale bounds need values that can be saved without rounding. Use up to six decimal places and exact bandwidth units."
msgstr "სკალის საზღვრებს სჭირდება მნიშვნელობები, რომელთა შენახვაც დამრგვალების გარეშე შეიძლება. გამოიყენეთ ექვსამდე ათწილადი ნიშანი და გამტარუნარიანობის ზუსტი ერთეულები."

#: lib/editor.colours.php
msgid "Duplicate range in a scale."
msgstr "დუბლირებული დიაპაზონი სკალაში."

#: lib/editor.colours.php
msgid "Gradients need two colours."
msgstr "გრადიენტებს სჭირდება ორი ფერი."

#: lib/editor.colours.php
msgid "Keep at least one DEFAULT traffic range."
msgstr "დატოვეთ ტრაფიკის მინიმუმ ერთი DEFAULT დიაპაზონი."

#: lib/editor.colours.php
#, php-format
msgid "A map object still uses scale %s."
msgstr "რუკის ობიექტი კვლავ იყენებს სკალას %s."

