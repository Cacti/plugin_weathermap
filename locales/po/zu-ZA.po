#: lib/editor.colours.php
msgid "Choose a valid colour."
msgstr "Khetha umbala ovumelekile."

#: lib/editor.colours.php
msgid "Invalid pulse setting."
msgstr "Isilungiselelo sokukhanyisa esingavumelekile."

#: lib/editor.colours.php
msgid "The background needs a solid colour."
msgstr "Ingemuva lidinga umbala oqinile."

#: lib/editor.colours.php
msgid "Keep between 1 and 200 scale rows."
msgstr "Gcina phakathi komugqa o-1 kuya kwengu-200 yesikali."

#: lib/editor.colours.php
#, php-format
msgid "Scale %s is defined in an included configuration and is read-only here. Edit its source file instead."
msgstr "Isikali %s sichazwe ekucushweni okufakiwe futhi singafundwa kuphela lapha. Hlela ifayela laso lomthombo esikhundleni salokho."

#: lib/editor.colours.php
msgid "Invalid scale name."
msgstr "Igama lesikali elingavumelekile."

#: lib/editor.colours.php
msgid "Invalid scale range."
msgstr "Ububanzi besikali obungavumelekile."

#: lib/editor.colours.php
msgid "Range start must be no greater than its end."
msgstr "Ukuqala kobubanzi akufanele kube kukhulu kunokuphela kwabo."

#: lib/editor.colours.php
msgid "Invalid scale label."
msgstr "Ilebula lesikali elingavumelekile."

#: lib/editor.colours.php
msgid "A solid colour label cannot begin with three integers. Add a word first or choose a gradient end colour."
msgstr "Ilebula lombala oqinile alikwazi ukuqala ngezinombolo ezintathu eziphelele. Engeza igama kuqala noma khetha umbala wokuphela kwe-gradient."

#: lib/editor.colours.php
msgid "Scale bounds need values that can be saved without rounding. Use up to six decimal places and exact bandwidth units."
msgstr "Imingcele yesikali idinga amanani angalondolozwa ngaphandle kokusondezwa. Sebenzisa amadesimali afika kwayisithupha namayunithi aqondile omkhawulokudonsa."

#: lib/editor.colours.php
msgid "Duplicate range in a scale."
msgstr "Ububanzi obuphindiwe esikalini."

#: lib/editor.colours.php
msgid "Gradients need two colours."
msgstr "Ama-gradient adinga imibala emibili."

#: lib/editor.colours.php
msgid "Keep at least one DEFAULT traffic range."
msgstr "Gcina okungenani ububanzi bethrafikhi obulodwa be-DEFAULT."

#: lib/editor.colours.php
#, php-format
msgid "A map object still uses scale %s."
msgstr "Into yemephu isasebenzisa isikali %s."

