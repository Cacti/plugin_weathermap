#: lib/editor.colours.php
msgid "Choose a valid colour."
msgstr "Khetha umbala osebenzayo."

#: lib/editor.colours.php
msgid "Invalid pulse setting."
msgstr "Isetingi yokudanyaza ayisebenzi."

#: lib/editor.colours.php
msgid "The background needs a solid colour."
msgstr "Umva ufuna umbala oqinileyo omnye."

#: lib/editor.colours.php
msgid "Keep between 1 and 200 scale rows."
msgstr "Gcina phakathi komqolo o-1 nama-200 wesikali."

#: lib/editor.colours.php
#, php-format
msgid "Scale %s is defined in an included configuration and is read-only here. Edit its source file instead."
msgstr "Isikali %s sichazwe kuqwalaselo olubandakanyiweyo kwaye sifundeka kuphela apha. Hlela ifayile yaso engumthombo endaweni yoko."

