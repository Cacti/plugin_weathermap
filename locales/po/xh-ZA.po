#: lib/editor.colours.php
msgid "Range start must be no greater than its end."
msgstr "Isiqalo somda masibe singabi sikhulu kunesiphelo sawo."

#: lib/editor.colours.php
msgid "Invalid scale label."
msgstr "Ileyibhile yesikali ayisebenzi."

#: lib/editor.colours.php
msgid "A solid colour label cannot begin with three integers. Add a word first or choose a gradient end colour."
msgstr "Ileyibhile yombala oqinileyo ayinakuqala ngamanani amathathu apheleleyo. Yongeza igama kuqala okanye khetha umbala wokuphela kwenguquko yombala."

#: lib/editor.colours.php
msgid "Scale bounds need values that can be saved without rounding. Use up to six decimal places and exact bandwidth units."
msgstr "Imida yesikali ifuna amaxabiso anokugcinwa ngaphandle kokurawundwa. Sebenzisa ukuya kwiindawo ezintandathu zedesimali kunye neeyunithi ze-bandwidth ezichanekileyo."

#: lib/editor.colours.php
msgid "Duplicate range in a scale."
msgstr "Umda ophindaphindiweyo kwisikali."

#: lib/editor.colours.php
msgid "Gradients need two colours."
msgstr "Iinguquko zombala zifuna imibala emibini."

#: lib/editor.colours.php
msgid "Keep at least one DEFAULT traffic range."
msgstr "Gcina ubuncinci umda omnye wetrefikhi o-DEFAULT."

#: lib/editor.colours.php
#, php-format
msgid "A map object still uses scale %s."
msgstr "Into yemephu isasebenzisa isikali %s."

