#: lib/editor.colours.php
msgid "Choose a valid colour."
msgstr "Изаберите исправну боју."

#: lib/editor.colours.php
msgid "Invalid pulse setting."
msgstr "Неисправно подешавање пулсирања."

#: lib/editor.colours.php
msgid "The background needs a solid colour."
msgstr "Позадина захтева пуну боју."

#: lib/editor.colours.php
msgid "Keep between 1 and 200 scale rows."
msgstr "Задржите између 1 и 200 редова скале."

#: lib/editor.colours.php
#, php-format
msgid "Scale %s is defined in an included configuration and is read-only here. Edit its source file instead."
msgstr "Скала %s је дефинисана у укљученој конфигурацији и овде је само за читање. Уместо тога измените њену изворну датотеку."

#: lib/editor.colours.php
msgid "Invalid scale name."
msgstr "Неисправан назив скале."

#: lib/editor.colours.php
msgid "Invalid scale range."
msgstr "Неисправан опсег скале."

#: lib/editor.colours.php
msgid "Range start must be no greater than its end."
msgstr "Почетак опсега не сме бити већи од његовог краја."

#: lib/editor.colours.php
msgid "Invalid scale label."
msgstr "Неисправна ознака скале."

#: lib/editor.colours.php
msgid "A solid colour label cannot begin with three integers. Add a word first or choose a gradient end colour."
msgstr "Ознака пуне боје не може почињати са три цела броја. Прво додајте реч или изаберите крајњу боју прелива."

#: lib/editor.colours.php
msgid "Scale bounds need values that can be saved without rounding. Use up to six decimal places and exact bandwidth units."
msgstr "Границе скале захтевају вредности које се могу сачувати без заокруживања. Користите до шест децималних места и тачне јединице пропусног опсега."

#: lib/editor.colours.php
msgid "Duplicate range in a scale."
msgstr "Дуплирани опсег у скали."

#: lib/editor.colours.php
msgid "Gradients need two colours."
msgstr "Преливи захтевају две боје."

#: lib/editor.colours.php
msgid "Keep at least one DEFAULT traffic range."
msgstr "Задржите бар један DEFAULT опсег саобраћаја."

#: lib/editor.colours.php
#, php-format
msgid "A map object still uses scale %s."
msgstr "Објекат мапе још увек користи скалу %s."

