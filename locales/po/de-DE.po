#: lib/editor.inc.php:265
#, php-format
msgid "Welcome to the PHP Weathermap %s Editor"
msgstr "Willkommen beim PHP Weathermap %s Editor"

#: lib/editor.inc.php:268
msgid "<b>NOTE:</b> This editor is not finished! There are many features of Weathermap that you will be missing out on if you choose to use the editor only.  These include: curves, node offsets, font definitions, colour changing, per-node/per-link settings and image uploading. You CAN use the editor without damaging these features if you added them by hand, however."
msgstr "<b>ANMERKUNG:</b> Dieser Editor ist noch nicht fertig! Es gibt viele Funktionen von Weathermap, die Sie verpassen werden, wenn Sie sich dafür entscheiden, nur den Editor zu verwenden.  Dazu gehören: Kurven, Knotenversätze, Schriftdefinitionen, Farbänderungen, Einstellungen pro Knoten/pro Link und das Hochladen von Bildern. Sie KÖNNEN den Editor jedoch verwenden, ohne diese Funktionen zu beschädigen, wenn Sie sie von Hand hinzugefügt haben."

