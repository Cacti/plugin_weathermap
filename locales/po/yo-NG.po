#: lib/editor.colours.php
msgid "Choose a valid colour."
msgstr "Yan àwọ̀ tó tọ́."

#: lib/editor.colours.php
msgid "Invalid pulse setting."
msgstr "Ètò ìlù kò tọ́."

#: lib/editor.colours.php
msgid "The background needs a solid colour."
msgstr "Àwọ̀ ẹ̀yìn nílò àwọ̀ líle kan."

#: lib/editor.colours.php
msgid "Keep between 1 and 200 scale rows."
msgstr "Pa láàárín ìlà ìwọ̀n 1 sí 200 mọ́."

#: lib/editor.colours.php
#, php-format
msgid "Scale %s is defined in an included configuration and is read-only here. Edit its source file instead."
msgstr "A ṣàlàyé ìwọ̀n %s nínú ìṣètò tí a fi kún un ó sì jẹ́ kíkà-nìkan níbí. Ṣàtúnṣe fáìlì orísun rẹ̀ dípò bẹ́ẹ̀."

#: lib/editor.colours.php
msgid "Invalid scale name."
msgstr "Orúkọ ìwọ̀n kò tọ́."

#: lib/editor.colours.php
msgid "Invalid scale range."
msgstr "Ààlà ìwọ̀n kò tọ́."

#: lib/editor.colours.php
msgid "Range start must be no greater than its end."
msgstr "Ìbẹ̀rẹ̀ ààlà kò gbọ́dọ̀ ju òpin rẹ̀ lọ."

#: lib/editor.colours.php
msgid "Invalid scale label."
msgstr "Àkọlé ìwọ̀n kò tọ́."

#: lib/editor.colours.php
msgid "A solid colour label cannot begin with three integers. Add a word first or choose a gradient end colour."
msgstr "Àkọlé àwọ̀ líle kò lè bẹ̀rẹ̀ pẹ̀lú nọ́ńbà odidi mẹ́ta. Fi ọ̀rọ̀ kan kún un ní àkọ́kọ́ tàbí yan àwọ̀ òpin ìyípadà-àwọ̀."

#: lib/editor.colours.php
msgid "Scale bounds need values that can be saved without rounding. Use up to six decimal places and exact bandwidth units."
msgstr "Àwọn òpin ìwọ̀n nílò àwọn iye tí a lè fipamọ́ láìsí ìyípo. Lo títí dé ìpín mẹ́fà lẹ́yìn àmì-ìdádúró àti àwọn ẹ̀ka ìgbàlódé pàtó."

#: lib/editor.colours.php
msgid "Duplicate range in a scale."
msgstr "Ààlà àdàkọ nínú ìwọ̀n kan."

#: lib/editor.colours.php
msgid "Gradients need two colours."
msgstr "Àwọn ìyípadà-àwọ̀ nílò àwọ̀ méjì."

#: lib/editor.colours.php
msgid "Keep at least one DEFAULT traffic range."
msgstr "Pa ó kéré jù ààlà ìrìn-àjò DEFAULT kan mọ́."

#: lib/editor.colours.php
#, php-format
msgid "A map object still uses scale %s."
msgstr "Ohun èlò máàpù kan ṣì ń lo ìwọ̀n %s."

