#: lib/editor.colours.php
msgid "Choose a valid colour."
msgstr "Misafidiana loko mety."

#: lib/editor.colours.php
msgid "Invalid pulse setting."
msgstr "Tsy mety ny fandrindrana fitepona."

#: lib/editor.colours.php
msgid "The background needs a solid colour."
msgstr "Mila loko tokana ny lafika."

#: lib/editor.colours.php
msgid "Keep between 1 and 200 scale rows."
msgstr "Mitazona andalana maridrefy eo anelanelan'ny 1 sy 200."

#: lib/editor.colours.php
#, php-format
msgid "Scale %s is defined in an included configuration and is read-only here. Edit its source file instead."
msgstr "Ny maridrefy %s dia nofaritana tao amin'ny fikirakirana tafiditra ary vakiana ihany eto. Ovao kosa ny rakitra loharanony."

#: lib/editor.colours.php
msgid "Invalid scale name."
msgstr "Tsy mety ny anaran'ny maridrefy."

#: lib/editor.colours.php
msgid "Invalid scale range."
msgstr "Tsy mety ny elanelan'ny maridrefy."

#: lib/editor.colours.php
msgid "Range start must be no greater than its end."
msgstr "Tsy mahazo lehibe noho ny fiafarany ny fanombohan'ny elanelana."

#: lib/editor.colours.php
msgid "Invalid scale label."
msgstr "Tsy mety ny mariky ny maridrefy."

#: lib/editor.colours.php
msgid "A solid colour label cannot begin with three integers. Add a word first or choose a gradient end colour."
msgstr "Tsy afaka manomboka amin'ny isa feno telo ny marika loko tokana. Manampia teny eo aloha na misafidiana loko fiafaran'ny fiovan-doko."

#: lib/editor.colours.php
msgid "Scale bounds need values that can be saved without rounding. Use up to six decimal places and exact bandwidth units."
msgstr "Mila sanda azo tehirizina tsy misy fanamarihana boribory ny fetran'ny maridrefy. Mampiasà hatramin'ny tarehimarika enina aorian'ny faingo sy singa sakan-dalana marina."

#: lib/editor.colours.php
msgid "Duplicate range in a scale."
msgstr "Elanelana miverimberina ao amin'ny maridrefy."

#: lib/editor.colours.php
msgid "Gradients need two colours."
msgstr "Mila loko roa ny fiovan-doko."

#: lib/editor.colours.php
msgid "Keep at least one DEFAULT traffic range."
msgstr "Mitazona elanelana fifamoivoizana DEFAULT iray farafahakeliny."

#: lib/editor.colours.php
#, php-format
msgid "A map object still uses scale %s."
msgstr "Mbola misy zavatra ao amin'ny sarintany mampiasa ny maridrefy %s."

