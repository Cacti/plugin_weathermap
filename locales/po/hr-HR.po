#: lib/editor.colours.php
msgid "Choose a valid colour."
msgstr "Odaberite važeću boju."

#: lib/editor.colours.php
msgid "Invalid pulse setting."
msgstr "Nevažeća postavka pulsiranja."

#: lib/editor.colours.php
msgid "The background needs a solid colour."
msgstr "Pozadina zahtijeva punu boju."

#: lib/editor.colours.php
msgid "Keep between 1 and 200 scale rows."
msgstr "Zadržite između 1 i 200 redaka ljestvice."

#: lib/editor.colours.php
#, php-format
msgid "Scale %s is defined in an included configuration and is read-only here. Edit its source file instead."
msgstr "Ljestvica %s definirana je u uključenoj konfiguraciji i ovdje je samo za čitanje. Umjesto toga uredite njezinu izvornu datoteku."

#: lib/editor.colours.php
msgid "Invalid scale name."
msgstr "Nevažeći naziv ljestvice."

#: lib/editor.colours.php
msgid "Invalid scale range."
msgstr "Nevažeći raspon ljestvice."

#: lib/editor.colours.php
msgid "Range start must be no greater than its end."
msgstr "Početak raspona ne smije biti veći od kraja."

#: lib/editor.colours.php
msgid "Invalid scale label."
msgstr "Nevažeća oznaka ljestvice."

#: lib/editor.colours.php
msgid "A solid colour label cannot begin with three integers. Add a word first or choose a gradient end colour."
msgstr "Oznaka pune boje ne može započeti s tri cijela broja. Prvo dodajte riječ ili odaberite završnu boju gradijenta."

#: lib/editor.colours.php
msgid "Scale bounds need values that can be saved without rounding. Use up to six decimal places and exact bandwidth units."
msgstr "Granice ljestvice zahtijevaju vrijednosti koje se mogu spremiti bez zaokruživanja. Upotrijebite najviše šest decimalnih mjesta i točne jedinice propusnosti."

#: lib/editor.colours.php
msgid "Duplicate range in a scale."
msgstr "Dvostruki raspon u ljestvici."

#: lib/editor.colours.php
msgid "Gradients need two colours."
msgstr "Gradijenti zahtijevaju dvije boje."

#: lib/editor.colours.php
msgid "Keep at least one DEFAULT traffic range."
msgstr "Zadržite barem jedan DEFAULT raspon prometa."

#: lib/editor.colours.php
#, php-format
msgid "A map object still uses scale %s."
msgstr "Objekt na karti još uvijek upotrebljava ljestvicu %s."

