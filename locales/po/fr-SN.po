#: lib/editor.colours.php
msgid "Choose a valid colour."
msgstr "Choisissez une couleur valide."

#: lib/editor.colours.php
msgid "Invalid pulse setting."
msgstr "Paramètre de pulsation invalide."

#: lib/editor.colours.php
msgid "The background needs a solid colour."
msgstr "L'arrière-plan nécessite une couleur unie."

#: lib/editor.colours.php
msgid "Keep between 1 and 200 scale rows."
msgstr "Conservez entre 1 et 200 lignes d'échelle."

#: lib/editor.colours.php
#, php-format
msgid "Scale %s is defined in an included configuration and is read-only here. Edit its source file instead."
msgstr "L'échelle %s est définie dans une configuration incluse et est en lecture seule ici. Modifiez plutôt son fichier source."

#: lib/editor.colours.php
msgid "Invalid scale name."
msgstr "Nom d'échelle invalide."

#: lib/editor.colours.php
msgid "Invalid scale range."
msgstr "Plage d'échelle invalide."

#: lib/editor.colours.php
msgid "Range start must be no greater than its end."
msgstr "Le début de la plage ne doit pas dépasser sa fin."

#: lib/editor.colours.php
msgid "Invalid scale label."
msgstr "Étiquette d'échelle invalide."

#: lib/editor.colours.php
msgid "A solid colour label cannot begin with three integers. Add a word first or choose a gradient end colour."
msgstr "Une étiquette de couleur unie ne peut pas commencer par trois entiers. Ajoutez d'abord un mot ou choisissez une couleur de fin de dégradé."

#: lib/editor.colours.php
msgid "Scale bounds need values that can be saved without rounding. Use up to six decimal places and exact bandwidth units."
msgstr "Les bornes d'échelle nécessitent des valeurs pouvant être enregistrées sans arrondi. Utilisez jusqu'à six décimales et des unités de bande passante exactes."

#: lib/editor.colours.php
msgid "Duplicate range in a scale."
msgstr "Plage en double dans une échelle."

#: lib/editor.colours.php
msgid "Gradients need two colours."
msgstr "Les dégradés nécessitent deux couleurs."

#: lib/editor.colours.php
msgid "Keep at least one DEFAULT traffic range."
msgstr "Conservez au moins une plage de trafic DEFAULT."

#: lib/editor.colours.php
#, php-format
msgid "A map object still uses scale %s."
msgstr "Un objet de carte utilise encore l'échelle %s."

