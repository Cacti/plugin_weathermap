#: lib/editor.colours.php
msgid "Choose a valid colour."
msgstr "Zaɓi launi mai inganci."

#: lib/editor.colours.php
msgid "Invalid pulse setting."
msgstr "Saitin bugawa (pulse) mara inganci."

#: lib/editor.colours.php
msgid "The background needs a solid colour."
msgstr "Bango yana buƙatar launi guda ɗaya tak."

#: lib/editor.colours.php
msgid "Keep between 1 and 200 scale rows."
msgstr "Kiyaye tsakanin layukan ma'auni 1 zuwa 200."

#: lib/editor.colours.php
#, php-format
msgid "Scale %s is defined in an included configuration and is read-only here. Edit its source file instead."
msgstr "An ayyana ma'auni %s a cikin saitin da aka haɗa kuma karatu kawai yake a nan. Gyara fayil ɗin asalinsa a maimakon haka."

#: lib/editor.colours.php
msgid "Invalid scale name."
msgstr "Sunan ma'auni mara inganci."

#: lib/editor.colours.php
msgid "Invalid scale range."
msgstr "Kewayon ma'auni mara inganci."

#: lib/editor.colours.php
msgid "Range start must be no greater than its end."
msgstr "Farkon kewayo dole ne kada ya fi ƙarshensa girma."

#: lib/editor.colours.php
msgid "Invalid scale label."
msgstr "Lambar lakabin ma'auni mara inganci."

#: lib/editor.colours.php
msgid "A solid colour label cannot begin with three integers. Add a word first or choose a gradient end colour."
msgstr "Lakabin launi guda ɗaya ba zai iya farawa da lambobi uku ba. Ƙara kalma da farko ko zaɓi launin ƙarshen sauyin launi (gradient)."

#: lib/editor.colours.php
msgid "Scale bounds need values that can be saved without rounding. Use up to six decimal places and exact bandwidth units."
msgstr "Iyakokin ma'auni suna buƙatar ƙimomin da za a iya ajiyewa ba tare da zagayewa ba. Yi amfani da har zuwa wuraren desimal shida da madaidaitan na'urorin ƙarfin hanyar bayanai."

#: lib/editor.colours.php
msgid "Duplicate range in a scale."
msgstr "Maimaita kewayo a cikin ma'auni."

#: lib/editor.colours.php
msgid "Gradients need two colours."
msgstr "Sauyin launi (gradients) yana buƙatar launuka biyu."

#: lib/editor.colours.php
msgid "Keep at least one DEFAULT traffic range."
msgstr "Kiyaye aƙalla kewayon zirga-zirga na DEFAULT guda ɗaya."

#: lib/editor.colours.php
#, php-format
msgid "A map object still uses scale %s."
msgstr "Har yanzu wani abin taswira yana amfani da ma'auni %s."

