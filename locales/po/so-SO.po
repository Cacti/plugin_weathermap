#: lib/editor.colours.php
msgid "Choose a valid colour."
msgstr "Dooro midab sax ah."

#: lib/editor.colours.php
msgid "Invalid pulse setting."
msgstr "Dejinta garaaca (pulse) ma saxna."

#: lib/editor.colours.php
msgid "The background needs a solid colour."
msgstr "Gadaalku wuxuu u baahan yahay midab adag."

#: lib/editor.colours.php
msgid "Keep between 1 and 200 scale rows."
msgstr "Hayso inta u dhexeysa 1 ilaa 200 oo saf miisaan ah."

#: lib/editor.colours.php
#, php-format
msgid "Scale %s is defined in an included configuration and is read-only here. Edit its source file instead."
msgstr "Miisaanka %s waxaa lagu qeexay habayn lagu daray waana akhri-kaliya halkan. Beddel faylkiisa asalka ah halkii."

#: lib/editor.colours.php
msgid "Invalid scale name."
msgstr "Magaca miisaanku ma saxna."

#: lib/editor.colours.php
msgid "Invalid scale range."
msgstr "Xadka miisaanku ma saxna."

#: lib/editor.colours.php
msgid "Range start must be no greater than its end."
msgstr "Bilowga xadku waa inuusan ka weynaan dhammaadkiisa."

#: lib/editor.colours.php
msgid "Invalid scale label."
msgstr "Calaamadda miisaanku ma saxna."

#: lib/editor.colours.php
msgid "A solid colour label cannot begin with three integers. Add a word first or choose a gradient end colour."
msgstr "Calaamadda midabka adag kuma bilaaban karto saddex tiro oo dhan. Ku dar eray marka hore ama dooro midabka dhammaadka ee midab-isbeddelka."

#: lib/editor.colours.php
msgid "Scale bounds need values that can be saved without rounding. Use up to six decimal places and exact bandwidth units."
msgstr "Xuduudaha miisaanku waxay u baahan yihiin qiimayaal la keydin karo iyadoon la soo koobin. Isticmaal ilaa lix meelood oo jajab ah iyo cutubyo sax ah oo baaxadda gudbinta ah."

#: lib/editor.colours.php
msgid "Duplicate range in a scale."
msgstr "Xad soo noqnoqday oo miisaan ku jira."

#: lib/editor.colours.php
msgid "Gradients need two colours."
msgstr "Midab-isbeddelku wuxuu u baahan yahay laba midab."

#: lib/editor.colours.php
msgid "Keep at least one DEFAULT traffic range."
msgstr "Hayso ugu yaraan hal xad socodka xogta ah oo DEFAULT ah."

#: lib/editor.colours.php
#, php-format
msgid "A map object still uses scale %s."
msgstr "Walax khariidad ah ayaa weli adeegsanaysa miisaanka %s."

