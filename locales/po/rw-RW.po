#: lib/editor.colours.php
msgid "Choose a valid colour."
msgstr "Hitamo ibara ryemewe."

#: lib/editor.colours.php
msgid "Invalid pulse setting."
msgstr "Igenamiterere ryo gutera ntikemewe."

#: lib/editor.colours.php
msgid "The background needs a solid colour."
msgstr "Inyuma hakeneye ibara rimwe ryuzuye."

#: lib/editor.colours.php
msgid "Keep between 1 and 200 scale rows."
msgstr "Gumisha imirongo y'igipimo hagati ya 1 na 200."

#: lib/editor.colours.php
#, php-format
msgid "Scale %s is defined in an included configuration and is read-only here. Edit its source file instead."
msgstr "Igipimo %s kigenwa mu igenamiterere ryinjijwe kandi gisomwa gusa hano. Hindura dosiye yacyo y'inkomoko ahubwo."

#: lib/editor.colours.php
msgid "Invalid scale name."
msgstr "Izina ry'igipimo ntikemewe."

#: lib/editor.colours.php
msgid "Invalid scale range."
msgstr "Intera y'igipimo ntikemewe."

#: lib/editor.colours.php
msgid "Range start must be no greater than its end."
msgstr "Intangiriro y'intera ntigomba kurenza iherezo ryayo."

#: lib/editor.colours.php
msgid "Invalid scale label."
msgstr "Ikirango cy'igipimo ntikemewe."

#: lib/editor.colours.php
msgid "A solid colour label cannot begin with three integers. Add a word first or choose a gradient end colour."
msgstr "Ikirango cy'ibara rimwe ntigishobora gutangirana n'imibare itatu yuzuye. Ongeraho ijambo mbere cyangwa uhitemo ibara rirangiza ihinduka ry'amabara."

#: lib/editor.colours.php
msgid "Scale bounds need values that can be saved without rounding. Use up to six decimal places and exact bandwidth units."
msgstr "Imipaka y'igipimo ikeneye agaciro gashobora kubikwa katagorowe. Koresha imibare itarenze itandatu nyuma y'akitso n'ibipimo nyabyo by'ubushobozi bw'umuyoboro."

#: lib/editor.colours.php
msgid "Duplicate range in a scale."
msgstr "Intera yasubiwemo mu gipimo."

#: lib/editor.colours.php
msgid "Gradients need two colours."
msgstr "Amabara ahinduranya akeneye amabara abiri."

#: lib/editor.colours.php
msgid "Keep at least one DEFAULT traffic range."
msgstr "Gumisha byibura intera imwe y'urujya n'uruza ya DEFAULT."

#: lib/editor.colours.php
#, php-format
