#: lib/editor.actions.php lib/editor.assets.php lib/editor.inc.php
msgid "Choose a PNG, JPG or GIF file up to 5 MB."
msgstr "እስከ 5 MB የሆነ የPNG፣ JPG ወይም GIF ፋይል ይምረጡ።"

#: lib/editor.actions.php
msgid "Use POST to save changes."
msgstr "ለውጦችን ለማስቀመጥ POST ይጠቀሙ።"

#: lib/editor.actions.php lib/editor.inc.php
msgid "This map has changed since you opened it. Reload the editor before saving your changes."
msgstr "ይህ ካርታ ከከፈቱት ጊዜ ጀምሮ ተቀይሯል። ለውጦችዎን ከማስቀመጥዎ በፊት አርታዒውን እንደገና ይጫኑ።"

#: lib/editor.actions.php
msgid "Cannot read the map configuration."
msgstr "የካርታውን ውቅር ማንበብ አልተቻለም።"

#: lib/editor.actions.php lib/editor.assets.php lib/editor.history.php
#: weathermap-cacti-plugin-mgmt.php
msgid "Could not lock map configurations."
msgstr "የካርታ ውቅሮችን መቆለፍ አልተቻለም።"

#: lib/editor.actions.php
msgid "This image is still referenced by a map configuration."
msgstr "ይህ ምስል አሁንም በካርታ ውቅር ውስጥ ተጠቅሷል።"

#: lib/editor.actions.php
msgid "Could not delete the image."
msgstr "ምስሉን መሰረዝ አልተቻለም።"

#: lib/editor.actions.php
msgid "Invalid colour settings."
msgstr "ልክ ያልሆኑ የቀለም ቅንብሮች።"

#: lib/editor.actions.php weathermap-cacti-plugin-mgmt.php
msgid "Could not save the map configuration."
msgstr "የካርታውን ውቅር ማስቀመጥ አልተቻለም።"

#: lib/editor.assets.php
msgid "Invalid image category."
msgstr "ልክ ያልሆነ የምስል ምድብ።"

#: lib/editor.assets.php
msgid "Symbolic links cannot be managed here."
msgstr "ምልክታዊ አገናኞች (Symbolic links) እዚህ ሊተዳደሩ አይችሉም።"

#: lib/editor.assets.php
msgid "Invalid image filename."
msgstr "ልክ ያልሆነ የምስል ፋይል ስም።"

#: lib/editor.assets.php
msgid "Cannot check configuration references."
msgstr "የውቅር ማጣቀሻዎችን ማረጋገጥ አልተቻለም።"

#: lib/editor.assets.php
msgid "Too many included configurations to check."
msgstr "ለማረጋገጥ በጣም ብዙ የተካተቱ ውቅሮች አሉ።"

#: lib/editor.assets.php
msgid "The image directory is not writable."
msgstr "የምስል ማውጫው ሊጻፍበት አይችልም።"

#: lib/editor.assets.php
msgid "Choose a PNG, JPG or GIF image up to 4 million pixels."
msgstr "እስከ 4 ሚሊዮን ፒክስሎች ያለው የPNG፣ JPG ወይም GIF ምስል ይምረጡ።"

#: lib/editor.assets.php
msgid "The image could not be read."
msgstr "ምስሉን ማንበብ አልተቻለም።"

#: lib/editor.assets.php
msgid "Could not reserve an image filename."
msgstr "የምስል ፋይል ስም መያዝ አልተቻለም።"

#: lib/editor.assets.php
msgid "Could not save the image."
msgstr "ምስሉን ማስቀመጥ አልተቻለም።"

#: lib/editor.colours.php
msgid "Choose a valid colour."
msgstr "ትክክለኛ ቀለም ይምረጡ።"

#: lib/editor.colours.php
msgid "Invalid pulse setting."
msgstr "ልክ ያልሆነ የምት (pulse) ቅንብር።"

#: lib/editor.colours.php
msgid "The background needs a solid colour."
msgstr "ዳራው ጠንካራ (አንድ ወጥ) ቀለም ያስፈልገዋል።"

#: lib/editor.colours.php
msgid "Keep between 1 and 200 scale rows."
msgstr "በ1 እና በ200 መካከል የመለኪያ ረድፎችን ያቆዩ።"

#: lib/editor.colours.php
#, php-format
msgid "Scale %s is defined in an included configuration and is read-only here. Edit its source file instead."
msgstr "መለኪያ %s በተካተተ ውቅር ውስጥ የተገለጸ ሲሆን እዚህ ለንባብ ብቻ ነው። ይልቁንም የምንጭ ፋይሉን ያርትዑ።"

#: lib/editor.colours.php
msgid "Invalid scale name."
msgstr "ልክ ያልሆነ የመለኪያ ስም።"

#: lib/editor.colours.php
msgid "Invalid scale range."
msgstr "ልክ ያልሆነ የመለኪያ ክልል።"

#: lib/editor.colours.php
msgid "Range start must be no greater than its end."
msgstr "የክልል መጀመሪያ ከመጨረሻው መብለጥ የለበትም።"

#: lib/editor.colours.php
msgid "Invalid scale label."
msgstr "ልክ ያልሆነ የመለኪያ መለያ ጽሑፍ።"

#: lib/editor.colours.php
msgid "A solid colour label cannot begin with three integers. Add a word first or choose a gradient end colour."
msgstr "ጠንካራ የቀለም መለያ በሦስት ሙሉ ቁጥሮች መጀመር አይችልም። መጀመሪያ ቃል ያክሉ ወይም የቀለም ሽግግር መጨረሻ ቀለም ይምረጡ።"

#: lib/editor.colours.php
msgid "Scale bounds need values that can be saved without rounding. Use up to six decimal places and exact bandwidth units."
msgstr "የመለኪያ ገደቦች ሳይጠጋጉ ሊቀመጡ የሚችሉ እሴቶችን ይፈልጋሉ። እስከ ስድስት የአስርዮሽ ቦታዎች እና ትክክለኛ የመተላለፊያ ይዘት አሃዶችን ይጠቀሙ።"

#: lib/editor.colours.php
msgid "Duplicate range in a scale."
msgstr "በመለኪያ ውስጥ የተደገመ ክልል።"

#: lib/editor.colours.php
msgid "Gradients need two colours."
msgstr "የቀለም ሽግግሮች ሁለት ቀለሞች ያስፈልጋቸዋል።"

#: lib/editor.colours.php
msgid "Keep at least one DEFAULT traffic range."
msgstr "ቢያንስ አንድ የDEFAULT የትራፊክ ክልል ያቆዩ።"

#: lib/editor.colours.php
#, php-format
msgid "A map object still uses scale %s."
msgstr "አንድ የካርታ ነገር አሁንም መለኪያ %s ን ይጠቀማል።"

#: lib/editor.comment-style.php
#, php-format
msgid "%s — %s pt (font %s)"
msgstr "%s — %s pt (ቅርጸ-ቁምፊ %s)"

#: lib/editor.comment-style.php
msgid "Blue (#0000FF)"
msgstr "ሰማያዊ (#0000FF)"

#: lib/editor.comment-style.php
msgid "Dark blue (#003366)"
msgstr "ጥቁር ሰማያዊ (#003366)"

#: lib/editor.comment-style.php
msgid "Royal blue (#0040C0)"
msgstr "ንጉሣዊ ሰማያዊ (#0040C0)"

#: lib/editor.comment-style.php
msgid "Teal (#007070)"
msgstr "ሰማያዊ-አረንጓዴ (#007070)"

#: lib/editor.comment-style.php
msgid "Green (#008000)"
msgstr "አረንጓዴ (#008000)"

#: lib/editor.comment-style.php
msgid "Purple (#8000C0)"
msgstr "ሐምራዊ (#8000C0)"

#: lib/editor.comment-style.php
msgid "Charcoal (#333333)"
msgstr "ከሰል ግራጫ (#333333)"

#: lib/editor.comment-style.php
msgid "Red (#C00000)"
msgstr "ቀይ (#C00000)"

#: lib/editor.comment-style.php
msgid "Black (#000000)"
msgstr "ጥቁር (#000000)"

#: lib/editor.comment-style.php
msgid "White (#FFFFFF)"
msgstr "ነጭ (#FFFFFF)"

#: lib/editor.comment-style.php
msgid "Automatic contrast with link colour"
msgstr "ከአገናኝ ቀለም ጋር ራስ-ሰር ንጽጽር"

#: lib/editor.comment-style.php
#, php-format
msgid "%s — %s pt"
msgstr "%s — %s pt"

#: lib/editor.comment-style.php
msgid "Bundled fonts"
msgstr "አብረው የመጡ ቅርጸ-ቁምፊዎች"

#: lib/editor.comment-style.php
msgid "Link Comment Font"
msgstr "የአገናኝ አስተያየት ቅርጸ-ቁምፊ"

#: lib/editor.comment-style.php
msgid "Link Comment Style"
msgstr "የአገናኝ አስተያየት ቅጥ"

#: lib/editor.comment-style.php weathermap-cacti-plugin-editor.php
msgid "Centre"
msgstr "መሃል"

#: lib/editor.comment-style.php
msgid "Edge"
msgstr "ጠርዝ"

#: lib/editor.comment-style.php
msgid "Edge places comments beside the link; Centre places them over the arrow."
msgstr "ጠርዝ አስተያየቶችን ከአገናኙ ጎን ያስቀምጣል፤ መሃል ደግሞ በቀስቱ ላይ ያስቀምጣቸዋል።"

#: lib/editor.comment-style.php
msgid "Follow link curve"
msgstr "የአገናኝ ኩርባን ተከተል"

#: lib/editor.comment-style.php
msgid "Link Comments"
msgstr "የአገናኝ አስተያየቶች"

#: lib/editor.comment-style.php
msgid "Uses a TrueType font. Tight bends or text longer than the link use straight text."
msgstr "የTrueType ቅርጸ-ቁምፊ ይጠቀማል። ጠባብ መታጠፊያዎች ወይም ከአገናኙ የሚረዝም ጽሑፍ ቀጥ ያለ ጽሑፍ ይጠቀማሉ።"

#: lib/editor.comment-style.php
msgid "Positions along the link: 0% is the first node and 100% is the second. These move the traffic labels, not the comments."
msgstr "በአገናኙ ላይ ያሉ ቦታዎች፦ 0% የመጀመሪያው ኖድ ሲሆን 100% ሁለተኛው ነው። እነዚህ የሚያንቀሳቅሱት የትራፊክ መለያዎችን እንጂ አስተያየቶችን አይደለም።"

#: lib/editor.comment-style.php
msgid "Traffic Label Positions"
msgstr "የትራፊክ መለያ ቦታዎች"

#: lib/editor.comment-style.php
msgid "IN"
msgstr "ገቢ (IN)"

#: lib/editor.comment-style.php
msgid "OUT"
msgstr "ወጪ (OUT)"

#: lib/editor.comment-style.php
msgid "Comment Style"
msgstr "የአስተያየት ቅጥ"

#: lib/editor.comment-style.php
msgid "Use map default"
msgstr "የካርታ ነባሪ ተጠቀም"

#: lib/editor.comment-style.php
msgid "Custom positions"
msgstr "ብጁ ቦታዎች"

#: lib/editor.config-delete.php
#, php-format
msgid "Delete configuration file %s"
msgstr "የውቅር ፋይል %s ሰርዝ"

#: lib/editor.config-delete.php
#, php-format
msgid "Are you sure you want to permanently delete the configuration file \"%s\"?"
msgstr "የውቅር ፋይሉን \"%s\" በቋሚነት መሰረዝ እንደሚፈልጉ እርግጠኛ ነዎት?"

#: lib/editor.history.php
msgid "An active session is required for Undo and Redo."
msgstr "ለመቀልበስ (Undo) እና ድጋሚ ለመስራት (Redo) ንቁ ክፍለ ጊዜ ያስፈልጋል።"

#: lib/editor.history.php
msgid "Could not create private map history storage."
msgstr "የግል የካርታ ታሪክ ማከማቻ መፍጠር አልተቻለም።"

#: lib/editor.history.php
msgid "Map history storage is not private."
msgstr "የካርታ ታሪክ ማከማቻው የግል አይደለም።"

#: lib/editor.history.php
msgid "Invalid map history storage."
msgstr "ልክ ያልሆነ የካርታ ታሪክ ማከማቻ።"

#: lib/editor.history.php
msgid "Add node"
msgstr "ኖድ አክል"

#: lib/editor.history.php
msgid "Clone node"
msgstr "ኖድ ቅዳ"

#: lib/editor.history.php
msgid "Delete node"
msgstr "ኖድ ሰርዝ"

#: lib/editor.history.php
msgid "Move node or note"
msgstr "ኖድ ወይም ማስታወሻ አንቀሳቅስ"

#: lib/editor.history.php
msgid "Add link"
msgstr "አገናኝ አክል"

#: lib/editor.history.php
msgid "Delete link"
msgstr "አገናኝ ሰርዝ"

#: lib/editor.history.php
msgid "Move link via point"
msgstr "የአገናኝ መተላለፊያ (via) ነጥብ አንቀሳቅስ"

#: lib/editor.history.php
msgid "Tidy link"
msgstr "አገናኝ አስተካክል"

#: lib/editor.history.php
msgid "Tidy all links"
msgstr "ሁሉንም አገናኞች አስተካክል"

#: lib/editor.history.php
msgid "Tidy links"
msgstr "አገናኞችን አስተካክል"

#: lib/editor.history.php
msgid "Edit note"
msgstr "ማስታወሻ አርትዕ"

#: lib/editor.history.php
msgid "Untidy links"
msgstr "የአገናኞችን ማስተካከያ አንሳ"

#: lib/editor.history.php
msgid "Edit link"
msgstr "አገናኝ አርትዕ"

#: lib/editor.history.php
msgid "Edit node"
msgstr "ኖድ አርትዕ"

#: lib/editor.history.php
msgid "Edit raw link configuration"
msgstr "ጥሬ የአገናኝ ውቅር አርትዕ"

#: lib/editor.history.php
msgid "Edit raw node configuration"
msgstr "ጥሬ የኖድ ውቅር አርትዕ"

#: lib/editor.history.php
msgid "Edit map properties"
msgstr "የካርታ ባህሪያትን አርትዕ"

#: lib/editor.history.php
msgid "Edit map style"
msgstr "የካርታ ቅጥ አርትዕ"

#: lib/editor.history.php
msgid "Edit map colours"
msgstr "የካርታ ቀለሞችን አርትዕ"

#: lib/editor.history.php
msgid "Move legend"
msgstr "የካርታ ቁልፍን አንቀሳቅስ"

#: lib/editor.history.php
msgid "Move timestamp"
msgstr "የጊዜ ማህተምን አንቀሳቅስ"

#: lib/editor.history.php
msgid "Edit map"
msgstr "ካርታ አርትዕ"

#: lib/editor.history.php
msgid "No matching history remains. Reload the editor."
msgstr "ምንም የሚዛመድ ታሪክ አልቀረም። አርታዒውን እንደገና ይጫኑ።"

